#!/usr/bin/env bash
# Project-local Crush config.
#
# go.mod requires go >= 1.27.1, but the host (NixOS) still ships go 1.26.5
# and a golangci-lint built with 1.26 — both LSPs fail with
# "go.mod requires go >= 1.27.1" / "can't load config". Until the host
# catches up, run the LSPs on current nixpkgs toolchains (nix-cached after
# the first build). Drop this file when the host go reaches 1.27.

GO_1_27="$(nix build nixpkgs#go_1_27 --print-out-paths --no-link)"
GOLANGCI_LS="$(nix build nixpkgs#golangci-lint-langserver --print-out-paths --no-link)"

lsp add gopls \
	--command gopls \
	--env PATH "$GO_1_27/bin:$PATH" \
	--timeout 60 \
	--init-options '{"analyses":{"stdversion":false}}' \
	--options '{"analyses":{"stdversion":false}}'

lsp add golangci_lint_ls \
	--command "$HOME/.local/bin/golangci-lint-lsp-wrapper" \
	--env PATH "$GOLANGCI_LS/bin:$GO_1_27/bin:$PATH"

# templ LSP must track go.mod's templ, not nixpkgs': the 0.3.1020 CLI
# generates code in-memory that the 0.3.1100 runtime no longer compiles
# (templ.ResolveAttributeValue was removed) — 42 false "undefined" project
# diagnostics that nixpkgs templ cannot see past. Drop this block when
# nixpkgs templ >= go.mod's templ.
TEMPL_VERSION="$(grep 'a-h/templ' go.mod | awk '{print $2}')"
TEMPL_BIN="$HOME/.cache/emeet-pixyd/templ-lsp/$TEMPL_VERSION/templ"
if [[ ! -x "$TEMPL_BIN" ]]; then
	mkdir -p "$(dirname "$TEMPL_BIN")"
	GOWORK=off GOBIN="$(dirname "$TEMPL_BIN")" "$GO_1_27/bin/go" install "github.com/a-h/templ/cmd/templ@$TEMPL_VERSION"
fi

lsp add templ \
	--command "$TEMPL_BIN" \
	--args lsp \
	--filetypes templ
