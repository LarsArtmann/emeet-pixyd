---
// Overrides Starlight's default Head to append the per-page OpenGraph image
// generated by astro-og-canvas at /open-graph/<page-id>.png.
const { head, id } = Astro.locals.starlightRoute;
const ogImage = new URL(`/open-graph/${id}.png`, Astro.site);
---

{
  head.map(({ tag: Tag, attrs, content }) => (
    <Tag {...attrs} set:html={content} />
  ))
}

<meta property="og:image" content={ogImage.href} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage.href} />
