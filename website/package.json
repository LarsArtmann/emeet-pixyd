  "private": true,
  "description": "Website and documentation for emeet-pixyd — auto-activation daemon for the EMEET PIXY webcam on Linux",
  "keywords": [
    "astro",
    "daemon",
    "emeet-pixy",
    "face-tracking",
    "hid",
    "linux",
    "nixos",
    "pipewire",
    "privacy",
    "starlight",
    "v4l2",
    "waybar",
    "webcam"
  ],
  "homepage": "https://emeet-pixyd.lars.software",
  "bugs": "https://github.com/LarsArtmann/emeet-pixyd/issues",
  "license": "MIT",
  "author": "LarsArtmann <lars@larsartmann.com> (https://larsartmann.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/LarsArtmann/emeet-pixyd.git",
    "directory": "website"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/fix-csp.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "clean": "rm -rf dist .astro node_modules/.cache",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.7",
    "@tailwindcss/vite": "^4.3.3",
