    "astro-og-canvas": "^0.13.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "html-validate": "^11.7.0",
    "typescript": "^7.0.2"
  },
